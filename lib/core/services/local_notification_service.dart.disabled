  // ---------------------------------------------------------------------------
  // Initialization
  // ---------------------------------------------------------------------------

  /// Initializes local notifications.
  ///
  /// Safe to call multiple times.
  Future<void> initialize() async {
    if (kIsWeb) return;

    if (_ready) return;

    // Prevent concurrent initialization.
    if (_initializing) return;

    _initializing = true;

    try {
      _initializeTimeZones();

      const androidSettings = AndroidInitializationSettings(
        '@mipmap/ic_launcher',
      );

      const darwinSettings = DarwinInitializationSettings(
        requestAlertPermission: false,
        requestBadgePermission: false,
        requestSoundPermission: false,
      );

      const linuxSettings = LinuxInitializationSettings(
        defaultActionName: 'Open',
      );

      const windowsSettings = WindowsInitializationSettings(
        appName: 'YouMatter',
        appUserModelId: 'com.youmatter.app',
        guid: '9f2f3e0a-0b31-4d44-9f4c-6f9f7e5c2b21',
      );

      const settings = InitializationSettings(
        android: androidSettings,
        iOS: darwinSettings,
        macOS: darwinSettings,
        linux: linuxSettings,
        windows: windowsSettings,
      );

      await _plugin.initialize(
        settings: settings,
        onDidReceiveNotificationResponse: _handleNotificationResponse,
      );

      _ready = true;
    } catch (e, stackTrace) {
      debugPrint(
        'YouMatter notification initialization failed: $e\n$stackTrace',
      );

      _ready = false;
    } finally {
      _initializing = false;
    }
  }

  // ---------------------------------------------------------------------------
  // Time zone
  // ---------------------------------------------------------------------------

  void _initializeTimeZones() {
    try {
      tzdata.initializeTimeZones();

      // timezone package starts with a default location.
      //
      // If your project later adds a native timezone plugin, this method
      // should be updated to set the actual device timezone.
      //
      // Keeping tz.local here makes the service safe while the native
      // timezone integration is not yet added.
      if (tz.local.name.isEmpty) {
        tz.setLocalLocation(tz.getLocation('UTC'));
      }
    } catch (e) {
      debugPrint('Timezone initialization failed: $e');

      try {
        tz.setLocalLocation(tz.getLocation('UTC'));
      } catch (_) {}
    }
  }

  // ---------------------------------------------------------------------------
  // Permissions
  // ---------------------------------------------------------------------------

  /// Requests notification permission.
  ///
  /// Returns true when notification permission is available.
  Future<bool> requestPermission() async {
    if (kIsWeb) return false;

    try {
      final status = await Permission.notification.request();

      return status.isGranted ||
          status.isLimited ||
          status.isProvisional;
    } catch (e) {
      debugPrint('Notification permission request failed: $e');
      return false;
    }
  }

  /// Checks whether notifications are currently allowed.
  Future<bool> areNotificationsAllowed() async {
    if (kIsWeb) return false;

    try {
      final status = await Permission.notification.status;

      return status.isGranted ||
          status.isLimited ||
          status.isProvisional;
    } catch (e) {
      debugPrint('Notification permission check failed: $e');
      return false;
    }
  }

  /// Opens the application's system settings.
  ///
  /// Useful when the user has permanently denied notifications.
  Future<bool> openNotificationSettings() async {
    if (kIsWeb) return false;

    try {
      return await openAppSettings();
    } catch (e) {
      debugPrint('Unable to open notification settings: $e');
      return false;
    }
  }

  // ---------------------------------------------------------------------------
  // Daily check-in
  // ---------------------------------------------------------------------------

  /// Enables a daily YouMatter check-in.
  ///
  /// Default:
  ///
  ///     09:00
  ///
  /// The notification repeats every day at the requested local time.
  Future<bool> enableDailyCheckIn({
    int hour = 9,
    int minute = 0,
  }) async {
    if (kIsWeb) return false;

    if (!_isValidTime(hour, minute)) {
      debugPrint(
        'Invalid daily check-in time: $hour:$minute',
      );

      return false;
    }

    final allowed = await requestPermission();

    if (!allowed) {
      return false;
    }

    await initialize();

    if (!_ready) {
      return false;
    }

    try {
      // Cancel first to ensure we never accidentally create duplicate
      // scheduled notifications.
      await _plugin.cancel(id: _dailyCheckInId);

      await _plugin.zonedSchedule(
        id: _dailyCheckInId,
        title:
        'How are you doing? ❤️',
        body: _nextCheckInMessage(),
        scheduledDate: _nextInstanceOf(hour, minute),
        notificationDetails: _dailyCheckInDetails(),
        androidScheduleMode:
            AndroidScheduleMode.inexactAllowWhileIdle,
        matchDateTimeComponents:
            DateTimeComponents.time,
        payload: 'daily_check_in',
      );

      return true;
    } catch (e, stackTrace) {
      debugPrint(
        'Daily check-in scheduling failed: $e\n$stackTrace',
      );

      return false;
    }
  }

  /// Disables the daily check-in.
  Future<void> disableDailyCheckIn() async {
    if (kIsWeb) return;

    await initialize();

    if (!_ready) return;

    try {
      await _plugin.cancel(id: _dailyCheckInId);
    } catch (e) {
      debugPrint('Unable to cancel daily check-in: $e');
    }
  }

  /// Reschedules the daily check-in to a new time.
  Future<bool> rescheduleDailyCheckIn({
    required int hour,
    required int minute,
  }) async {
    return enableDailyCheckIn(
      hour: hour,
      minute: minute,
    );
  }

  // ---------------------------------------------------------------------------
  // Someone needs to talk
  // ---------------------------------------------------------------------------

  /// Shows a notification when a listener receives a new request.
  Future<bool> showSomeoneNeedsTalk(String topic) async {
    if (kIsWeb) return false;

    final allowed = await areNotificationsAllowed();

    if (!allowed) {
      return false;
    }

    await initialize();

    if (!_ready) {
      return false;
    }

    final cleanedTopic = topic.trim();

    final body = cleanedTopic.isEmpty
        ? 'Someone is looking for a listener. Would you like to respond?'
        : 'New request: "$cleanedTopic"';

    try {
      await _plugin.show(
        id: _someoneNeedsTalkId,
        title: 'Someone needs to talk 💬',
        body: body,
        notificationDetails: _someoneNeedsTalkDetails(),
        payload: 'listener_offer',
      );

      return true;
    } catch (e, stackTrace) {
      debugPrint(
        'Someone-needs-talk notification failed: $e\n$stackTrace',
      );

      return false;
    }
  }

  /// Cancels an existing listener request notification.
  Future<void> cancelSomeoneNeedsTalk() async {
    if (kIsWeb) return;

    await initialize();

    if (!_ready) return;

    try {
      await _plugin.cancel(id: _someoneNeedsTalkId);
    } catch (e) {
      debugPrint(
        'Unable to cancel listener notification: $e',
      );
    }
  }

  // ---------------------------------------------------------------------------
  // Cancel everything
  // ---------------------------------------------------------------------------

  Future<void> cancelAllNotifications() async {
    if (kIsWeb) return;

    await initialize();

    if (!_ready) return;

    try {
      await _plugin.cancelAll();
    } catch (e) {
      debugPrint(
        'Unable to cancel all notifications: $e',
      );
    }
  }

  // ---------------------------------------------------------------------------
  // Notification details
  // ---------------------------------------------------------------------------

  NotificationDetails _dailyCheckInDetails() {
    return const NotificationDetails(
      android: AndroidNotificationDetails(
        _dailyCheckInChannelId,
        _dailyCheckInChannelName,
        channelDescription: _dailyCheckInChannelDescription,
        importance: Importance.low,
        priority: Priority.low,
        playSound: false,
        enableVibration: false,
        icon: '@mipmap/ic_launcher',
      ),
      iOS: DarwinNotificationDetails(
        presentAlert: true,
        presentBadge: false,
        presentSound: false,
      ),
    );
  }

  NotificationDetails _someoneNeedsTalkDetails() {
    return const NotificationDetails(
      android: AndroidNotificationDetails(
        _someoneNeedsTalkChannelId,
        _someoneNeedsTalkChannelName,
        channelDescription: _someoneNeedsTalkChannelDescription,
        importance: Importance.high,
        priority: Priority.high,
        playSound: true,
        enableVibration: true,
        icon: '@mipmap/ic_launcher',
      ),
      iOS: DarwinNotificationDetails(
        presentAlert: true,
        presentBadge: true,
        presentSound: true,
      ),
    );
  }

  // ---------------------------------------------------------------------------
  // Notification tap handling
  // ---------------------------------------------------------------------------

  void _handleNotificationResponse(
    NotificationResponse response,
  ) {
    try {
      final payload = response.payload;

      debugPrint(
        'YouMatter notification tapped: $payload',
      );

      onNotificationTap?.call(payload);
    } catch (e) {
      debugPrint(
        'Notification tap handling failed: $e',
      );
    }
  }

  // ---------------------------------------------------------------------------
  // Message rotation
  // ---------------------------------------------------------------------------

  /// Returns the message assigned to the current calendar day.
  ///
  /// The same message is shown for everyone on the same day.
  /// This avoids random messages changing between scheduling attempts.
  String _nextCheckInMessage() {
    final now = DateTime.now();

    final dayNumber = _daysSinceEpoch(
      DateTime(
        now.year,
        now.month,
        now.day,
      ),
    );

    final index = dayNumber % _checkInMessages.length;

    return _checkInMessages[index];
  }

  int _daysSinceEpoch(DateTime date) {
    final epoch = DateTime(1970, 1, 1);

    return date.difference(epoch).inDays;
  }

  // ---------------------------------------------------------------------------
  // Scheduling helpers
  // ---------------------------------------------------------------------------

  tz.TZDateTime _nextInstanceOf(
    int hour,
    int minute,
  ) {
    final now = tz.TZDateTime.now(tz.local);

    var scheduled = tz.TZDateTime(
      tz.local,
      now.year,
      now.month,
      now.day,
      hour,
      minute,
    );

    if (!scheduled.isAfter(now)) {
      scheduled = scheduled.add(
        const Duration(days: 1),
      );
    }

    return scheduled;
  }

  bool _isValidTime(
    int hour,
    int minute,
  ) {
    return hour >= 0 &&
        hour <= 23 &&
        minute >= 0 &&
        minute <= 59;
  }

  // ---------------------------------------------------------------------------
  // Status
  // ---------------------------------------------------------------------------

  bool get isReady => _ready;
}