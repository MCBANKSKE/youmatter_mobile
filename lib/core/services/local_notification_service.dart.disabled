import 'package:flutter/foundation.dart';
import 'package:flutter_local_notifications/flutter_local_notifications.dart';
import 'package:permission_handler/permission_handler.dart';
import 'package:timezone/data/latest_all.dart' as tzdata;
import 'package:timezone/timezone.dart' as tz;

/// Central notification service for YouMatter.
///
/// Responsibilities:
/// - OS notification permissions
/// - Daily caring check-in notifications
/// - Listener request notifications
/// - Notification tap handling
/// - Scheduling/cancelling notifications
///
/// Notifications are best-effort and must never crash the application.
class LocalNotificationService {
  LocalNotificationService._();

  static final LocalNotificationService instance =
      LocalNotificationService._();

  final FlutterLocalNotificationsPlugin _plugin =
      FlutterLocalNotificationsPlugin();

  // ---------------------------------------------------------------------------
  // Notification IDs
  // ---------------------------------------------------------------------------

  static const int _dailyCheckInId = 1001;
  static const int _someoneNeedsTalkId = 2001;

  // ---------------------------------------------------------------------------
  // Android channels
  // ---------------------------------------------------------------------------

  static const String _dailyCheckInChannelId = 'daily_check_in';

  static const String _dailyCheckInChannelName = 'Daily check-in';

  static const String _dailyCheckInChannelDescription =
      'A gentle daily reminder from YouMatter';

  static const String _someoneNeedsTalkChannelId = 'someone_needs_talk';

  static const String _someoneNeedsTalkChannelName = 'Someone needs to talk';

  static const String _someoneNeedsTalkChannelDescription =
      'Notifications when someone needs a listener';

  // ---------------------------------------------------------------------------
  // Initialization state
  // ---------------------------------------------------------------------------

  bool _ready = false;
  bool _initializing = false;

  /// Optional callback when a notification is tapped.
  ///
  /// Example:
  ///
  /// LocalNotificationService.instance.onNotificationTap = (payload) {
  ///   // Navigate using your router.
  /// };
  void Function(String? payload)? onNotificationTap;

